@page "/contact"

<PageTitle>Contact - Reserva</PageTitle>

<div class="contact-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="contact-hero">

        <div class="contact-hero-content">

            <span class="contact-eyebrow">
                GET IN TOUCH
            </span>

            <h1>
                We'd love to<br />
                <span>hear from you.</span>
            </h1>

            <p>
                Have a question, feedback, or need help with Reserva?
                Send us a message and we'll be happy to help.
            </p>

        </div>

    </section>


    <!-- =====================================================
         CONTACT INFORMATION + FORM
    ====================================================== -->

    <section class="contact-section">

        <div class="contact-container">

            <div class="contact-grid">

                <!-- LEFT SIDE -->

                <div class="contact-info">

                    <span class="section-label">
                        CONTACT US
                    </span>

                    <h2>
                        Let's start a<br />
                        <span>conversation.</span>
                    </h2>

                    <p class="contact-info-text">
                        Whether you have a question about booking,
                        managing your business, or simply want to
                        share your feedback, we're here to help.
                    </p>


                    <div class="contact-details">

                        <div class="contact-detail">

                            <div class="contact-detail-icon">
                                <i class="bi bi-envelope"></i>
                            </div>

                            <div>
                                <span>Email</span>
                                <strong>hello@reserva.com</strong>
                            </div>

                        </div>


                        <div class="contact-detail">

                            <div class="contact-detail-icon">
                                <i class="bi bi-geo-alt"></i>
                            </div>

                            <div>
                                <span>Location</span>
                                <strong>Saudi Arabia</strong>
                            </div>

                        </div>


                        <div class="contact-detail">

                            <div class="contact-detail-icon">
                                <i class="bi bi-clock"></i>
                            </div>

                            <div>
                                <span>Support Hours</span>
                                <strong>Sunday – Thursday</strong>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- RIGHT SIDE / FORM -->

                <div class="contact-form-card">

                    <div class="contact-form-header">

                        <span class="form-label">
                            SEND A MESSAGE
                        </span>

                        <h3>
                            How can we help?
                        </h3>

                    </div>


                    <form>

                        <div class="contact-form-row">

                            <div class="contact-field">

                                <label for="contact-name">
                                    Your Name
                                </label>

                                <input
                                    id="contact-name"
                                    type="text"
                                    placeholder="Enter your name" />

                            </div>


                            <div class="contact-field">

                                <label for="contact-email">
                                    Email Address
                                </label>

                                <input
                                    id="contact-email"
                                    type="email"
                                    placeholder="Enter your email" />

                            </div>

                        </div>


                        <div class="contact-field">

                            <label for="contact-subject">
                                Subject
                            </label>

                            <input
                                id="contact-subject"
                                type="text"
                                placeholder="What is this about?" />

                        </div>


                        <div class="contact-field">

                            <label for="contact-message">
                                Message
                            </label>

                            <textarea
                                id="contact-message"
                                rows="6"
                                placeholder="Tell us how we can help..."></textarea>

                        </div>


                        <button
                            type="submit"
                            class="contact-submit">

                            Send Message

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FAQ
    ====================================================== -->

    <section class="contact-section contact-light">

        <div class="contact-container">

            <div class="contact-section-header">

                <span class="section-label">
                    QUICK ANSWERS
                </span>

                <h2>
                    Before you <span>reach out.</span>
                </h2>

            </div>


            <div class="contact-faq-grid">

                <div class="contact-faq-card">

                    <div class="contact-faq-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <h3>
                        Need help with a booking?
                    </h3>

                    <p>
                        You can manage your appointments directly
                        from your customer dashboard.
                    </p>

                </div>


                <div class="contact-faq-card">

                    <div class="contact-faq-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <h3>
                        Are you a business owner?
                    </h3>

                    <p>
                        Reserva helps you manage your services,
                        employees, working hours, and appointments.
                    </p>

                </div>


                <div class="contact-faq-card">

                    <div class="contact-faq-icon">
                        <i class="bi bi-chat-dots"></i>
                    </div>

                    <h3>
                        Have feedback?
                    </h3>

                    <p>
                        We'd love to hear your ideas and suggestions
                        for making Reserva better.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="contact-cta">

        <div class="contact-cta-content">

            <span class="contact-eyebrow">
                RESERVA
            </span>

            <h2>
                Your time matters.
            </h2>

            <p>
                Discover services, find the right time,
                and make your next appointment simple.
            </p>

            <a href="/services" class="contact-cta-button">

                Explore Services

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </section>

</div>