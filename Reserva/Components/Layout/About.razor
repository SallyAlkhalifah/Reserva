@page "/about"

<PageTitle>About - Reserva</PageTitle>

<div class="about-page">

    <!-- ================= HERO ================= -->

    <section class="about-hero">

        <div class="about-hero-content">

            <span class="about-eyebrow">
                ABOUT RESERVA
            </span>

            <h1>
                Book Your Time.
                <br />
                <span>Simply.</span>
            </h1>

            <p>
                Reserva makes appointment booking simple, organized,
                and convenient for both customers and businesses.
            </p>

        </div>

    </section>


    <!-- ================= INTRO ================= -->

    <section class="about-section">

        <div class="about-container about-intro">

            <div class="about-heading">

                <span class="section-label">
                    OUR PLATFORM
                </span>

                <h2>
                    Everything you need to
                    <span>manage your time.</span>
                </h2>

            </div>

            <div class="about-text">

                <p>
                    Reserva is an appointment booking platform designed
                    to connect customers with businesses in a simple
                    and organized way.
                </p>

                <p>
                    Customers can discover services, choose their preferred
                    employee, select a suitable date and time, and manage
                    their appointments from one place.
                </p>

                <p>
                    Businesses can manage their services, employees,
                    working hours, and customer appointments through
                    an easy-to-use management experience.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= WHAT WE OFFER ================= -->

    <section class="about-section about-light">

        <div class="about-container">

            <div class="section-header">

                <span class="section-label">
                    WHAT WE OFFER
                </span>

                <h2>
                    Designed for both
                    <span>customers and businesses.</span>
                </h2>

            </div>


            <div class="about-cards">

                <div class="about-card">

                    <div class="about-card-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <h3>
                        Easy Booking
                    </h3>

                    <p>
                        Find a service, choose an employee,
                        select a convenient time, and book
                        your appointment with ease.
                    </p>

                </div>


                <div class="about-card">

                    <div class="about-card-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <h3>
                        Employee Management
                    </h3>

                    <p>
                        Businesses can organize their employees,
                        assign services, and manage their working
                        schedules in one place.
                    </p>

                </div>


                <div class="about-card">

                    <div class="about-card-icon">
                        <i class="bi bi-grid"></i>
                    </div>

                    <h3>
                        Business Management
                    </h3>

                    <p>
                        Manage services, working hours, locations,
                        and appointments through a centralized
                        business dashboard.
                    </p>

                </div>


                <div class="about-card">

                    <div class="about-card-icon">
                        <i class="bi bi-clock"></i>
                    </div>

                    <h3>
                        Better Time Management
                    </h3>

                    <p>
                        Keep appointments organized and make it easier
                        for customers and employees to stay on schedule.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= HOW IT WORKS ================= -->

    <section class="about-section">

        <div class="about-container">

            <div class="section-header">

                <span class="section-label">
                    HOW IT WORKS
                </span>

                <h2>
                    A simpler way to
                    <span>book appointments.</span>
                </h2>

            </div>


            <div class="steps-container">

                <div class="about-step">

                    <div class="step-number">
                        01
                    </div>

                    <div>
                        <h3>
                            Explore
                        </h3>

                        <p>
                            Browse businesses and discover
                            the services that match your needs.
                        </p>
                    </div>

                </div>


                <div class="about-step">

                    <div class="step-number">
                        02
                    </div>

                    <div>
                        <h3>
                            Choose
                        </h3>

                        <p>
                            Select your preferred service,
                            employee, date, and available time.
                        </p>
                    </div>

                </div>


                <div class="about-step">

                    <div class="step-number">
                        03
                    </div>

                    <div>
                        <h3>
                            Book
                        </h3>

                        <p>
                            Confirm your appointment and
                            keep everything organized in your account.
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= WHY RESERVA ================= -->

    <section class="about-section about-dark">

        <div class="about-container why-reserva">

            <div>

                <span class="section-label section-label-light">
                    WHY RESERVA
                </span>

                <h2>
                    Less searching.
                    <br />
                    Less waiting.
                    <br />
                    <span>More time for what matters.</span>
                </h2>

            </div>


            <div class="why-text">

                <p>
                    Reserva brings the appointment process into one
                    connected experience, helping customers and
                    businesses manage their time more efficiently.
                </p>

                <p>
                    From discovering a service to managing an appointment,
                    every step is designed to be clear, simple, and easy
                    to use.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= CTA ================= -->

    <section class="about-cta">

        <div class="about-cta-content">

            <span class="about-eyebrow">
                START WITH RESERVA
            </span>

            <h2>
                Your time matters.
            </h2>

            <p>
                Find a service and book your next appointment with Reserva.
            </p>

            <a href="/services" class="about-cta-button">
                Explore Services
                <i class="bi bi-arrow-right"></i>
            </a>

        </div>

    </section>

</div>