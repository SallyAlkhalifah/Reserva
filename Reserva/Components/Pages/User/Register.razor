@page "/register"

@using Reserva.Application.DTOs
@using Reserva.Application.Interfaces

@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Create Account - Reserva</PageTitle>

<div class="register-page">

    <div class="register-container">

        <div class="register-header">

            <span class="register-eyebrow">
                JOIN RESERVA
            </span>

            <h1>
                Create your
                <span>account.</span>
            </h1>

            <p>
                Choose how you want to use Reserva.
            </p>

        </div>


        @if (string.IsNullOrEmpty(selectedRole))
        {
            <div class="account-type-grid">

                <button class="account-type-card"
                        @onclick="@(() => SelectRole("User"))">

                    <div class="account-type-icon">
                        👤
                    </div>

                    <div>
                        <h2>I'm a Customer</h2>

                        <p>
                            Discover businesses and book appointments
                            easily.
                        </p>
                    </div>

                    <span class="account-type-arrow">
                        →
                    </span>

                </button>


                <button class="account-type-card"
                        @onclick="@(() => SelectRole("BusinessOwner"))">

                    <div class="account-type-icon">
                        ◈
                    </div>

                    <div>
                        <h2>I'm a Business Owner</h2>

                        <p>
                            Create and manage your business,
                            services and appointments.
                        </p>
                    </div>

                    <span class="account-type-arrow">
                        →
                    </span>

                </button>

            </div>
        }
        else
        {
            <div class="register-form-card">

                <button class="back-button"
                        @onclick="GoBack">
                    ← Back
                </button>


                <div class="selected-account">

                    @if (selectedRole == "BusinessOwner")
                    {
                        <span>BUSINESS OWNER ACCOUNT</span>
                        <h2>Create your business account</h2>
                    }
                    else
                    {
                        <span>CUSTOMER ACCOUNT</span>
                        <h2>Create your account</h2>
                    }

                </div>


                <EditForm Model="@registerModel"
                          OnValidSubmit="RegisterAsync">

                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="register-error">
                            @errorMessage
                        </div>
                    }


                    <div class="form-group">
                        <label>First Name</label>

                        <InputText @bind-Value="registerModel.FirstName"
                                   class="form-input"
                                   placeholder="Enter your First name" />
                    </div>

                    
                    <div class="form-group">

                        <label>Last Name</label>

                        <InputText @bind-Value="registerModel.LastName"
                                   class="form-input"
                                   placeholder="Enter your Last name" />

                    </div>


                    <div class="form-group">

                        <label>Email</label>

                        <InputText @bind-Value="registerModel.Email"
                                   class="form-input"
                                   type="email"
                                   placeholder="you@example.com" />

                    </div>


                    <div class="form-group">

                        <label>Phone Number</label>

                        <InputText @bind-Value="registerModel.PhoneNumber"
                                   class="form-input"
                                   placeholder="05XXXXXXXX" />

                    </div>


                    <div class="form-group">

                        <label>Password</label>

                        <InputText @bind-Value="registerModel.Password"
                                   class="form-input"
                                   type="password"
                                   placeholder="Create a password" />

                    </div>


                    <button type="submit"
                            class="register-button"
                            disabled="@isSubmitting">

                        @if (isSubmitting)
                        {
                            <span>Creating account...</span>
                        }
                        else
                        {
                            <span>Create Account →</span>
                        }

                    </button>

                </EditForm>

            </div>
        }


        <div class="login-link">

            Already have an account?

            <a href="/login">
                Sign in
            </a>

        </div>

    </div>

</div>


@code {

    private string? selectedRole;

    private bool isSubmitting;

    private string? errorMessage;

    private CreateUserDto registerModel = new();


    private void SelectRole(string role)
    {
        selectedRole = role;

        registerModel.Role = role;
    }


    private void GoBack()
    {
        selectedRole = null;

        errorMessage = null;

        registerModel = new CreateUserDto();
    }


    private async Task RegisterAsync()
    {
        try
        {
            isSubmitting = true;
            errorMessage = null;

            registerModel.Role = selectedRole ?? "User";

            var userId =
                await UserService.CreateUserAsync(registerModel);

            if (registerModel.Role == "BusinessOwner")
            {
                Navigation.NavigateTo(
                    $"/business/dashboard?ownerId={userId}");
            }
            else
            {
                Navigation.NavigateTo(
                    $"/customer/dashboard?userId={userId}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}