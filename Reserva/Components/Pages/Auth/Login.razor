@page "/login"

@using Reserva.Application.Interfaces
@using Reserva.Application.Services
@using System.ComponentModel.DataAnnotations
@inject CurrentUserService CurrentUserService
@inject IUserService UserService
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components

<PageTitle>Sign In - Reserva</PageTitle>

<div class="login-page">

    <div class="login-container">

        <!-- LEFT SIDE -->

        <section class="login-brand-panel">

            <div class="brand-content">

                <img src="/images/reserva-logo2.png"
                     alt="Reserva"
                     class="login-logo" />

                <h1>Welcome back</h1>

                <p>
                    Manage your business, appointments and services
                    with ease.
                </p>

                <div class="brand-divider"></div>

                <span>BOOK YOUR TIME</span>

            </div>

        </section>


        <!-- RIGHT SIDE -->

        <section class="login-form-panel">

            <div class="login-form-container">

                <div class="login-heading">

                    <span class="login-eyebrow">
                        WELCOME BACK
                    </span>

                    <h2>Sign in to Reserva</h2>

                    <p>
                        Enter your details to access your account.
                    </p>

                </div>


                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="login-error">
                        @Message
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="login-error">
                        @errorMessage
                    </div>
                }


                <EditForm Model="@loginModel"
                          OnValidSubmit="@HandleLogin">

                    <DataAnnotationsValidator />


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label for="login">
                            Email or Username
                        </label>

                        <InputText id="login"
                                   @bind-Value="loginModel.Login"
                                   class="login-input"
                                   placeholder="Enter your email or username" />

                        <ValidationMessage For="@(() => loginModel.Login)" />

                    </div>


                    <!-- PASSWORD -->

                    <div class="form-group">

                        <label for="password">
                            Password
                        </label>

                        <InputText id="password"
                                   @bind-Value="loginModel.Password"
                                   type="password"
                                   class="login-input"
                                   placeholder="Enter your password" />

                        <ValidationMessage For="@(() => loginModel.Password)" />

                    </div>


                    <!-- OPTIONS -->

                    <div class="login-options">

                        <label class="remember-me">

                            <InputCheckbox @bind-Value="loginModel.RememberMe" />

                            <span>
                                Remember me
                            </span>

                        </label>


                        <a href="/forgot-password"
                           class="forgot-password">

                            Forgot password?

                        </a>

                    </div>


                    <!-- BUTTON -->

                    <button type="submit"
                            class="sign-in-button"
                            disabled="@isLoggingIn">

                        @if (isLoggingIn)
                        {
                            <span>
                                Signing in...
                            </span>
                        }
                        else
                        {
                            <span>
                                Sign In
                            </span>

                            <span class="sign-in-arrow">
                                →
                            </span>
                        }

                    </button>

                </EditForm>


                <!-- DIVIDER -->

                <div class="login-divider">

                    <span></span>

                    <small>or</small>

                    <span></span>

                </div>


                <!-- CREATE ACCOUNT -->

                <div class="create-account">

                    <span>
                        Don't have an account?
                    </span>

                    <a href="/register">
                        Create an account
                    </a>

                </div>


                <!-- FOOTER -->

                <div class="login-footer">

                    © 2026 Reserva

                    <span>•</span>

                    Book your time

                </div>

            </div>

        </section>

    </div>

</div>


@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "message")]
    public string? Message { get; set; }

    private LoginModel loginModel = new();

    private string? errorMessage;

    private bool isLoggingIn;


    private async Task HandleLogin()
    {
        try
        {
            isLoggingIn = true;
            errorMessage = null;

            var user = await UserService.LoginAsync(
                loginModel.Login,
                loginModel.Password);


            if (user == null)
            {
                errorMessage = "Invalid email or password.";
                return;
            }
            CurrentUserService.SetUser(user);


            // If the user came from booking,
            // return them to the page they were on.

            if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                Navigation.NavigateTo(ReturnUrl);
                return;
            }


            // Otherwise use the normal role-based redirect.

            if (user.Role == "BusinessOwner")
            {
                Navigation.NavigateTo(
                    $"/business/dashboard?ownerId={user.Id}");
            }
            else if (user.Role == "Employee")
            {
                Navigation.NavigateTo(
                    "/employee/dashboard");
            }
            else if (user.Role == "User")
            {
                Navigation.NavigateTo(
                    $"/customer/dashboard?userId={user.Id}");
            }
            else
            {
                errorMessage =
                    "Your account role is not recognized.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoggingIn = false;
        }
    }


    private class LoginModel
    {
        [Required(ErrorMessage = "Invalid email/username or password.")]
        public string Login { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }

}